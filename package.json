{
  "name": "wish-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Global wish platform built on humanity's shared culture of asking for blessings — stone cairns, ema plaques, wishing fountains, sky lanterns and more. One channel per ritual, one small offering per wish.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
