# Deployment (never commit the real .env)
DEPLOYER_KEY=0x...            # private key of the deploy wallet (needs Base Sepolia ETH)
VOUCHER_SIGNER=0x...          # ADDRESS of the backend voucher-signing wallet (its private key goes to the server, not here)
TREASURY=0x...                # multisig recommended; defaults to the deployer
TEAM=0x...                    # beneficiary of the 24-month vesting; defaults to the deployer
COMMUNITY=0x...
LIQUIDITY=0x...
REVENUE_BPS=5000              # share of every stone that goes to stakers
SALE_START=2026-12-01T00:00:00Z
SALE_DAYS=14
TOKEN_PRICE_USDC=20000        # $0.02 per CAIRN
SOFT_CAP_USDC=250000000000    # $250k
HARD_CAP_USDC=2000000000000   # $2M
MAX_PER_WALLET_USDC=25000000000
# Optional: use real testnet stablecoins instead of deploying mocks (first entry is the default token)
# STABLES=[{"symbol":"USDC","address":"0x036CbD53842c5426634e7929541eC2318f3dCF7e","decimals":6,"price":"100000"}]
BASESCAN_KEY=                 # for `npx hardhat verify`
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
