# Wish Cairn server
PORT=3000
APP_URL=http://localhost:3000
ADMIN_TOKEN=change-me                 # for tools/seed-users.mjs
PAYMENT_PROVIDERS=paypal              # paypal | mock (mock only outside production)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
ANTHROPIC_API_KEY=                    # seed-users wishes (optional; bank fallback without it)

# On-chain layer (optional)
CHAIN_DEPLOYMENT=chain/deployments/baseSepolia.json
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_POLL_MS=6000
VOUCHER_SIGNER_KEY=0x...              # private key whose address was deployed as the contract's voucherSigner

# Chain deployment stages (see docs/MAINNET.md): STAGE=stones first (no token yet), STAGE=token later with the real name
# TOKEN_NAME=Dol
# TOKEN_SYMBOL=DOL

# Donation pledge shown to visitors/investors (on-chain it is enforced by DONATION/DONATION_BPS in chain/.env)
DONATION_BPS=1000          # 10% of every stone's revenue
DONATION_NAME=             # recipient, once chosen (e.g. "UNICEF Korea"); empty = "being chosen"
DONATION_URL=
KARMA_AB=0                 # 1 = A/B test: odd wallet ids do not see karma/giving; compare on /analytics

# The firmament touch (once): height in metres, stone credits for every wisher, extra for the keystone's wallet
FIRMAMENT_M=250
FIRMAMENT_REWARD=1
FIRMAMENT_KEYSTONE_REWARD=10

# X autopost (tools/post-x.mjs): app keys + user access token with Read and Write permission
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_AUTOPOST=00:30          # HH:MM UTC, once a day (09:30 KST); leave empty to post manually
X_LANG=en                 # en | ko
X_SITE_URL=https://your-domain   # link in the post (defaults to APP_URL)
X_DAY0=2026-12-01         # launch date → "Day N:" prefix (optional)
