# --- Database ---
DATABASE_URL="file:./dev.db"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base offering in KRW. 100 KRW ≈ USD 0.07
WISH_BASE_KRW=100

# --- Payment providers ---
# Which providers to expose in the UI (comma separated): mock,paypal,crypto
PAYMENT_PROVIDERS="mock"
# Mock is auto-disabled when NODE_ENV=production. Set to 1 only on staging.
ALLOW_MOCK_PAYMENTS=0

# PayPal (Orders API v2). Use sandbox credentials for dev.
PAYPAL_ENV="sandbox"            # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Crypto (Coinbase Commerce-compatible hosted charge API)
CRYPTO_API_KEY=""
CRYPTO_WEBHOOK_SECRET=""

# --- FX (KRW -> other currencies). Static fallback rates; override with a live feed later.
FX_USD_PER_KRW=0.00072
FX_JPY_PER_KRW=0.11
FX_EUR_PER_KRW=0.00066
