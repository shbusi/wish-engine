// Wish Engine data model.
// Dev: SQLite. Prod: switch provider to "postgresql" and set DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A ritual channel (Korean stone cairn, Japanese ema, Trevi fountain, ...)
model Channel {
  id          String   @id            // slug, e.g. "stone-cairn"
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  wishCount   Int      @default(0)    // denormalized counter of fulfilled (paid) wishes
  createdAt   DateTime @default(now())
  wishes      Wish[]
}

/// One wish. Created as PENDING at checkout, becomes OFFERED once payment is confirmed.
model Wish {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id])
  text        String                  // the wish itself (max 280 chars)
  author      String?                 // optional display name
  locale      String   @default("en")
  isPublic    Boolean  @default(true)
  status      String   @default("PENDING") // PENDING | OFFERED | FAILED | REFUNDED
  amountKrw   Int      @default(100)  // offering in KRW (base currency), min 100
  offeredAt   DateTime?
  createdAt   DateTime @default(now())
  payment     Payment?
  walletId    String?                 // set when paid with a credit
  wallet      CreditWallet? @relation(fields: [walletId], references: [id])
  // --- share loop
  shareCount  Int      @default(0)    // share button clicks on this wish
  referrals   Int      @default(0)    // wishes offered by people who arrived via this wish's shared link
  viaWishId   String?                 // the wish whose shared link brought this wisher here
  // --- rarity
  rarity      String   @default("COMMON") // COMMON | UNCOMMON | RARE | LEGENDARY (rolled when offered)
  relic       Relic?

  @@index([channelId, status, offeredAt])
}

/// Payment record. Attached to exactly one of: a wish, or a credit-pack purchase.
model Payment {
  id            String   @id @default(cuid())
  wishId        String?  @unique
  wish          Wish?    @relation(fields: [wishId], references: [id])
  purchaseId    String?  @unique
  purchase      CreditPurchase? @relation(fields: [purchaseId], references: [id])
  provider      String                 // "paypal" | "crypto" | "mock" | "credits"
  providerRef   String?                // PayPal order id / crypto charge id
  currency      String                 // charged currency, e.g. "USD", "USDC"
  amount        String                 // charged amount as decimal string
  amountKrw     Int                    // KRW equivalent at checkout
  status        String   @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  rawEvent      String?                // last webhook payload (JSON) for audit
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([provider, providerRef])
}

/// Idempotency log for webhooks.
model WebhookEvent {
  id          String   @id            // provider event id
  provider    String
  receivedAt  DateTime @default(now())
}

/// Anonymous credit wallet. Identified by a secret token stored in a cookie
/// (and shown once as a recovery code). ₩1,000 pack = 10 wishes.
model CreditWallet {
  id          String   @id @default(cuid())
  token       String   @unique
  credits     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchases   CreditPurchase[]
  txns        CreditTxn[]
  wishes      Wish[]
  relics      Relic[]  @relation("owner")
  bids        Bid[]
}

model CreditPurchase {
  id          String   @id @default(cuid())
  walletId    String
  wallet      CreditWallet @relation(fields: [walletId], references: [id])
  packId      String
  credits     Int
  amountKrw   Int
  status      String   @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  createdAt   DateTime @default(now())
  payment     Payment?

  @@index([walletId, status])
}

/// Append-only ledger of credit movements.
model CreditTxn {
  id          String   @id @default(cuid())
  walletId    String
  wallet      CreditWallet @relation(fields: [walletId], references: [id])
  delta       Int
  reason      String   // purchase | spend | refund
  refId       String?  // purchase id or wish id
  createdAt   DateTime @default(now())

  @@index([walletId, createdAt])
}

/// A rare object that dropped with a wish: a jade stone, a gilded ema, an ancient coin.
model Relic {
  id             String   @id @default(cuid())
  wishId         String   @unique
  wish           Wish     @relation(fields: [wishId], references: [id])
  channelId      String
  rarity         String   // UNCOMMON | RARE | LEGENDARY
  variantId      String   // e.g. "stone-cairn:RARE"
  finderWalletId String
  ownerWalletId  String
  owner          CreditWallet @relation("owner", fields: [ownerWalletId], references: [id])
  createdAt      DateTime @default(now())
  auctions       Auction[]

  @@index([ownerWalletId])
  @@index([rarity, createdAt])
}

/// Credit-denominated auction of a relic. Bids lock credits; outbid credits are refunded.
model Auction {
  id                 String   @id @default(cuid())
  relicId            String
  relic              Relic    @relation(fields: [relicId], references: [id])
  sellerWalletId     String
  minBidCredits      Int
  startsAt           DateTime @default(now())
  endsAt             DateTime
  status             String   @default("OPEN") // OPEN | SETTLED | ENDED (no bids) | CANCELLED
  winnerWalletId     String?
  winningBidCredits  Int?
  feeCredits         Int?
  createdAt          DateTime @default(now())
  bids               Bid[]

  @@index([status, endsAt])
  @@index([relicId])
}

model Bid {
  id         String   @id @default(cuid())
  auctionId  String
  auction    Auction  @relation(fields: [auctionId], references: [id])
  walletId   String
  wallet     CreditWallet @relation(fields: [walletId], references: [id])
  credits    Int
  status     String   @default("ACTIVE") // ACTIVE | OUTBID | WON | REFUNDED
  createdAt  DateTime @default(now())

  @@index([auctionId, status, credits])
  @@index([walletId])
}
